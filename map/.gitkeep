<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- 제출 전 실제 팀번호·팀명·팀원 정보를 입력하세요. -->
    <meta name="project" content="SCENE:SEOUL">
    <meta name="team" content="팀번호_팀명 입력 필요">
    <meta name="contributors" content="팀원 이름 및 학번 입력 필요">
    <meta name="description" content="SCENE:SEOUL — 서울의 전시와 문화 콘텐츠를 탐색하는 웹사이트">
    <title>SCENE SEOUL | Map</title>

    <style>
        * {
            box-sizing: border-box;
        }

        /* [페이지 이동] 고정 헤더에 제목이 가리지 않도록 스크롤 여백을 줍니다. */
        html {
            scroll-behavior: smooth;
            scroll-padding-top: 20px;
        }

        /* [페이지 기본값] 헤더 높이만큼 본문을 내리고, 전체 배경·글자색·글꼴을 설정합니다. */
        body {
            margin: 0;
            background: #e8eaff;
            color: #171717;
            font-family: Arial, "Noto Sans KR", sans-serif;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        /* HEADER */

        /* [상단 메뉴] 헤더를 화면 위에 고정하고 반투명 배경과 흐림 효과를 적용합니다. */
        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            padding: 23px 5%;
            border-bottom: 1.5px solid #171717;
        }

        /* [로고] SCENE:SEOUL 로고의 글꼴, 크기, 굵기와 자간을 설정합니다. */
        .logo {
            font-size: 27px;
            font-weight: 900;
            letter-spacing: -1.5px;
            white-space: nowrap;
        }

        /* [로고 강조] 로고 안의 SEOUL 부분을 노란색 배경으로 강조합니다. */
        .logo span {
            background: #f8f13d;
            padding: 3px 6px;
        }

        /* [메뉴 항목] 메뉴 사이 간격, 글자색, 크기와 굵기를 지정합니다. */
        nav {
            display: flex;
            align-items: center;
            gap: 25px;
            font-size: 12px;
            font-weight: 900;
        }

        /* [메뉴 애니메이션] 메뉴에 마우스를 올릴 때 색이 부드럽게 바뀌게 합니다. */
        nav a {
            padding: 8px 0;
        }

        /* [메뉴 호버] 마우스를 올린 메뉴의 글자색을 브랜드 파란색으로 바꿉니다. */
        nav a:hover {
            background: #f8f13d;
        }

        nav .active {
            border-bottom: 3px solid #171717;
        }

        /* [계정 메뉴] 로그인 등 계정 관련 링크의 기본 색과 호버 색을 설정합니다. */
        .account {
            display: flex;
            gap: 14px;
            font-size: 10px;
            font-weight: 900;
            white-space: nowrap;
        }

        /* INTRO */

        .intro {
            padding: 48px 5% 25px;
        }

        /* [작은 섹션 제목] EYEBROW 스타일의 강조 색을 파란색으로 지정합니다. */
        .eyebrow {
            font-size: 11px;
            font-weight: 900;
            letter-spacing: 2px;
        }

        /* [섹션 제목 장식] 작은 제목 앞 장식 요소를 노란색으로 표시합니다. */
        .eyebrow::before {
            content: "";
            display: inline-block;
            width: 9px;
            height: 9px;
            margin-right: 9px;
            background: #f8f13d;
            border: 1px solid #171717;
            border-radius: 50%;
        }

        .intro h1 {
            margin: 17px 0 10px;
            font-size: clamp(55px, 8vw, 100px);
            line-height: 1;
            letter-spacing: -6px;
            font-weight: 900;
        }

        .intro h1 span {
            color: transparent;
            -webkit-text-stroke: 1.5px #171717;
        }

        .intro-bottom {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 20px;
        }

        .intro-bottom p {
            font-size: 13px;
            line-height: 1.8;
        }

        .intro-side {
            font-size: 10px;
            line-height: 1.8;
            font-weight: 800;
            text-align: right;
        }

        /* CATEGORY */

        .category-filters {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            padding: 20px 5% 25px;
        }

        .category-filters a {
            min-width: 105px;
            padding: 12px 20px;
            border: 1.5px solid #171717;
            border-radius: 30px;
            text-align: center;
            font-size: 12px;
            font-weight: 900;
            transition: background 0.2s, box-shadow 0.2s;
        }

        /* [선택된 필터] 마우스를 올리거나 선택된 필터를 노란색으로 강조합니다. */
        .category-filters a:hover,
        .category-filters a.selected {
            background: #f8f13d;
            box-shadow: 2px 2px 0 #171717;
        }

        /* MAP */

        .map-section {
            padding: 0 5% 45px;
        }

        .map-topline {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 14px;
        }

        .map-topline strong {
            font-size: 12px;
            letter-spacing: 1px;
        }

        .map-topline span {
            font-size: 10px;
            font-weight: 800;
        }

        /* [지도 바깥 영역] 지도 컨테이너의 배경, 둥근 모서리, 테두리와 그림자입니다. */
        .map-stage {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            min-height: 400px;
            padding: 35px 12%;
            border: 1.5px solid #171717;
            background: #dfe2ff;
            box-shadow: 6px 6px 0 #171717;
        }

        /* [서울 지도 전체] 지도 SVG 아래에 은은한 그림자를 넣습니다. */
        .seoul-map {
            display: block;
            width: 100%;
            max-width: 720px;
            height: auto;
            overflow: visible;
            filter: drop-shadow(5px 7px 0 rgba(23, 23, 23, 0.12));
        }

        /*
           지도 기본 상태:
           구역 경계선은 흰색으로 고정.
           호버 시에는 구역 색상만 변경.
        */

        /* [지도 구역] 각 자치구의 기본 채움색, 경계선, 호버 전환 효과를 지정합니다. */
        .district {
            fill: #bfc5f5;
            stroke: #ffffff;
            stroke-width: 2.2;
            stroke-linejoin: round;
            stroke-linecap: round;
            cursor: pointer;
            transition: fill 0.18s ease;
        }

        /* [지도 구역 호버] 구역에 마우스를 올리거나 키보드로 선택하면 노란색으로 바뀝니다. */
        .district-link:hover .district,
        .district-link:focus .district {
            fill: #f8f13d;
            stroke: #ffffff;
            stroke-width: 2.2;
        }

        .district-link:focus {
            outline: none;
        }

        /* [지도 구역 이름] 구역명 글자와 글자 뒤 테두리 색을 설정합니다. */
        .district-label {
            fill: #171717;
            font-size: 10.5px;
            font-weight: 800;
            text-anchor: middle;
            dominant-baseline: central;
            pointer-events: none;
            paint-order: stroke;
            stroke: #bfc5f5;
            stroke-width: 2.5px;
            stroke-linejoin: round;
        }

        .district-link:hover .district-label {
            stroke: #f8f13d;
        }

        /* [한강 선] 지도 위 한강을 파란 계열 선으로 표시합니다. */
        .river {
            fill: none;
            stroke: #91baff;
            stroke-width: 25;
            stroke-linecap: round;
            stroke-linejoin: round;
            pointer-events: none;
        }

        .river-edge {
            fill: none;
            stroke: #ffffff;
            stroke-width: 1.5;
            pointer-events: none;
        }

        /* [지도 범례] 지도 위 범례 상자의 배경, 테두리, 모서리와 글자색입니다. */
        .map-legend {
            position: absolute;
            left: 18px;
            top: 18px;
            padding: 10px 13px;
            background: rgba(248, 249, 255, 0.96);
            border: 1px solid #171717;
            font-size: 10px;
            font-weight: 800;
            line-height: 2;
        }

        /* [범례 표시점] 범례의 색상 점에 얇은 테두리를 추가합니다. */
        .legend-dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            margin-right: 7px;
            border: 1px solid #171717;
            border-radius: 50%;
            vertical-align: -1px;
        }

        .yellow { background: #f8f13d; }
        .orange { background: #ff795f; }
        .blue { background: #73baff; }
        .green { background: #84dca9; }

        /* [지도 안내 문구] 지도 사용 안내를 노란색 안내 상자로 표시합니다. */
        .map-hint {
            position: absolute;
            right: 18px;
            bottom: 18px;
            padding: 9px 12px;
            border: 1px solid #171717;
            background: #f8f13d;
            font-size: 10px;
            font-weight: 900;
        }

        /* DISTRICT CONTENT */

        .district-content {
            display: none;
            padding: 35px 5% 65px;
            border-top: 1.5px solid #171717;
            scroll-margin-top: 20px;
        }

        .district-content:target {
            display: block;
            animation: reveal 0.25s ease-out;
        }

        @keyframes reveal {
            from {
                opacity: 0;
                transform: translateY(8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .district-title {
            display: flex;
            justify-content: space-between;
            align-items: end;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 25px;
        }

        /* [지역 태그] 지역명이나 분류 태그를 노란색 라벨로 표시합니다. */
        .district-tag {
            display: inline-block;
            padding: 6px 10px;
            margin-bottom: 10px;
            background: #f8f13d;
            border: 1px solid #171717;
            font-size: 10px;
            font-weight: 900;
        }

        .district-title h2 {
            margin: 0;
            font-size: clamp(30px, 4vw, 44px);
            letter-spacing: -2px;
        }

        .district-title p {
            margin: 8px 0 0;
            font-size: 12px;
            line-height: 1.8;
        }

        .district-title > strong {
            font-size: 11px;
        }

        /* EVENT CARDS */

        .local-filters {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
            margin-bottom: 24px;
        }

        .local-filters a {
            padding: 9px 15px;
            border: 1px solid #171717;
            border-radius: 25px;
            font-size: 11px;
            font-weight: 800;
            transition: background 0.2s;
        }

        .local-filters a:hover,
        .local-filters a.selected {
            background: #f8f13d;
            box-shadow: 2px 2px 0 #171717;
        }

        .local-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
        }

        .event-card {
            min-width: 0;
            display: flex;
            flex-direction: column;
            background: #f7f7ff;
            border: 1.5px solid #171717;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .event-card:hover {
            transform: translateY(-4px);
            box-shadow: 4px 4px 0 #171717;
        }

        .event-poster {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 160px;
            overflow: hidden;
            border-bottom: 1.5px solid #171717;
        }

        .event-poster::before {
            content: "";
            width: 90px;
            height: 90px;
            background: #f8f13d;
            border: 1.5px solid #171717;
            border-radius: 50%;
            transition: transform 0.3s;
        }

        .event-card:hover .event-poster::before {
            transform: scale(1.15) rotate(15deg);
        }

        .poster-art { background: #ffb6a3; }

        .poster-music {
            background: #171717;
        }

        .poster-music::before {
            background: #f8f13d;
            border-radius: 0;
            transform: rotate(45deg);
        }

        .poster-popup {
            background: #c5caff;
        }

        .poster-popup::before {
            background: #ff795f;
            border-radius: 0;
            transform: rotate(30deg);
        }

        .poster-event {
            background: #c7f0d0;
        }

        .poster-event::before {
            background: #f7f7ff;
            border-radius: 0;
            transform: rotate(-15deg);
        }

        .event-type {
            position: absolute;
            top: 10px;
            left: 10px;
            padding: 5px 8px;
            background: white;
            border: 1px solid #171717;
            font-size: 9px;
            font-weight: 900;
        }

        .event-info {
            display: flex;
            flex-direction: column;
            flex: 1;
            padding: 14px;
        }

        .event-info h3 {
            margin: 0 0 10px;
            font-size: 15px;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .event-info p {
            margin: 0 0 5px;
            color: #555;
            font-size: 11px;
            line-height: 1.7;
        }

        .event-link {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            margin-top: auto;
            padding-top: 13px;
            border-top: 1px solid #171717;
            font-size: 10px;
            font-weight: 900;
        }

        .event-link span {
            transition: transform 0.2s;
        }

        .event-card:hover .event-link span {
            transform: translateX(4px);
        }

        .sample-note {
            margin: 0 0 20px;
            padding: 12px 15px;
            background: #f7f7ff;
            border-left: 3px solid #171717;
            font-size: 11px;
            line-height: 1.8;
        }

        .empty-message {
            padding: 25px;
            border: 1px dashed #171717;
            background: #f7f7ff;
            font-size: 12px;
            line-height: 1.9;
        }

        /* DEFAULT PANEL */

        .district-placeholder {
            padding: 35px 5% 65px;
            border-top: 1.5px solid #171717;
        }

        /* [콘텐츠 준비 안내] 아직 표시할 콘텐츠가 없는 영역의 배경과 모서리입니다. */
        .placeholder-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 25px;
            padding: 30px;
            border: 1.5px solid #171717;
            background: #f8f13d;
        }

        .placeholder-inner h2 {
            margin: 0 0 10px;
            font-size: 28px;
            letter-spacing: -1px;
        }

        .placeholder-inner p {
            margin: 0;
            font-size: 12px;
            line-height: 1.8;
        }

        /* [준비 안내 버튼] 콘텐츠 안내 영역의 링크를 파란색 버튼으로 표시합니다. */
        .placeholder-inner a {
            flex-shrink: 0;
            padding: 12px 16px;
            border: 1.5px solid #171717;
            background: #f7f7ff;
            font-size: 11px;
            font-weight: 900;
        }

        /* 선택한 지역이 있을 때 기본 안내 숨기기 */

        body:has(.district-content:target) .district-placeholder {
            display: none;
        }

        /* FOOTER */

        /* [하단 푸터] 페이지 하단을 어두운 배경으로 만들어 본문과 구분합니다. */
        footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            padding: 25px 5%;
            background: #171717;
            color: white;
            font-size: 10px;
            font-weight: 700;
        }

        /* [푸터 강조] 푸터 안 핵심 텍스트를 노란색으로 강조합니다. */
        footer strong {
            color: #f8f13d;
            font-size: 18px;
            letter-spacing: -1px;
        }

        footer strong span {
            background: #f8f13d;
            color: #171717;
        }

        /* [태블릿 대응] 화면 폭이 900px 이하일 때 상단 메뉴 여백을 조정합니다. */
        @media (max-width: 900px) {
            header {
                flex-wrap: wrap;
            }

            nav {
                order: 3;
                width: 100%;
                flex-wrap: wrap;
                gap: 18px;
            }

            .map-stage {
                padding: 75px 4% 60px;
                min-height: 300px;
            }

            .map-legend {
                top: 10px;
                left: 10px;
                padding: 5px 8px;
                font-size: 9px;
                line-height: 1.6;
            }

            .local-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        /* [모바일 대응] 작은 화면에서는 헤더 높이와 로고 크기를 조정합니다. */
        @media (max-width: 560px) {
            header {
                padding: 20px 5%;
            }

            .logo {
                font-size: 22px;
            }

            nav {
                gap: 13px;
                font-size: 10px;
            }

            .intro h1 {
                letter-spacing: -4px;
            }

            .intro-bottom {
                align-items: flex-start;
            }

            .intro-side {
                font-size: 9px;
            }

            .category-filters {
                gap: 8px;
            }

            .category-filters a {
                min-width: 0;
                flex: 1 1 28%;
                padding: 10px 8px;
                font-size: 10px;
            }

            .map-stage {
                padding: 85px 2% 55px;
                min-height: 240px;
            }

            .district-label {
                font-size: 9px;
            }

            .map-hint {
                right: 8px;
                bottom: 8px;
                font-size: 9px;
            }

            .placeholder-inner {
                align-items: flex-start;
                flex-direction: column;
                padding: 22px;
            }

            .local-grid {
                grid-template-columns: 1fr;
            }

            .event-poster {
                height: 200px;
            }

            footer {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    
        /* SCENE:SEOUL 공통 디자인 시스템 적용 — 기존 HTML 구조와 기능은 유지 */
        /* [폰트] 영문은 DM Sans, 한글은 Noto Sans KR을 불러옵니다. 인터넷 연결이 필요합니다. */
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&family=Noto+Sans+KR:wght@400;500;600;700;800;900&display=swap');

        /* [공통 색상 변수] 아래에서 반복해서 쓸 브랜드 색을 한 곳에 모아 둡니다. */
        :root {
            --ss-blue: #4666B0;
            --ss-blue-hover: #344F94;
            --ss-yellow: #FFDB63;
            --ss-paper: #F6F4EF;
            --ss-ink: #151B27;
            --ss-muted: #747B85;
            --ss-line: #DFE1DF;
            --ss-white: #FFFFFF;
        }

        html {
            scroll-padding-top: 92px;
        }

        body {
            padding-top: 76px;
            background: var(--ss-paper);
            color: var(--ss-ink);
            font-family: 'DM Sans', 'Noto Sans KR', sans-serif;
        }

        header {
            position: fixed;
            inset: 0 0 auto 0;
            z-index: 1000;
            min-height: 76px;
            padding: 14px 5%;
            gap: 24px;
            background: rgba(246, 244, 239, 0.94);
            border-bottom: 1px solid var(--ss-line);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
        }

        .logo {
            color: var(--ss-ink);
            font-family: 'DM Sans', 'Noto Sans KR', sans-serif;
            font-size: 24px;
            font-weight: 900;
            letter-spacing: -1.2px;
        }

        .logo span {
            background: var(--ss-yellow);
            color: var(--ss-ink);
            border-radius: 4px;
            padding: 3px 6px;
        }

        nav {
            gap: clamp(12px, 2vw, 27px);
            color: var(--ss-muted);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .04em;
        }

        nav a {
            transition: color .2s ease, background-color .2s ease;
        }

        nav a:hover {
            color: var(--ss-blue);
            background: transparent;
        }

        /* [현재 메뉴 표시] 현재 페이지 메뉴에 파란색 글자와 밑줄을 표시합니다. */
        nav a.active,
        nav .active {
            color: var(--ss-blue);
            border-bottom: 2px solid var(--ss-blue);
        }

        .account {
            color: var(--ss-muted);
        }

        .account a:hover {
            color: var(--ss-blue);
        }

        .eyebrow {
            color: var(--ss-blue);
        }

        .eyebrow::before {
            background: var(--ss-yellow);
            border-color: var(--ss-blue);
        }

        /* [메인 제목] 지도 페이지와 전시 페이지의 큰 제목 색과 글자 간격을 통일합니다. */
        .intro h1,
        .page-intro h1 {
            color: var(--ss-ink);
            letter-spacing: -.065em;
        }

        /* [제목 강조 글자] 제목 안 강조 문자의 외곽선을 브랜드 파란색으로 만듭니다. */
        .intro h1 span,
        .page-intro h1 span {
            -webkit-text-stroke: 1.5px var(--ss-blue);
        }

        /* [보조 설명] 설명문과 발행 정보처럼 부가적인 텍스트를 회색으로 통일합니다. */
        .intro-bottom p,
        .intro-side,
        .edition,
        .section-heading p,
        .map-topline span {
            color: var(--ss-muted);
        }

        /* [필터 기본 모양] 카테고리·지역 필터를 얇은 테두리와 밝은 배경으로 통일합니다. */
        .category-filters a,
        .local-filters a,
        .filter-option {
            border: 1px solid var(--ss-line);
            color: var(--ss-ink);
            background: rgba(255, 255, 255, .55);
            transition: background .2s ease, color .2s ease, border-color .2s ease, transform .2s ease;
        }

        .category-filters a:hover,
        .category-filters a.selected,
        .local-filters a:hover,
        .local-filters a.selected,
        #type-all:checked ~ .filters label[for="type-all"],
        #type-art:checked ~ .filters label[for="type-art"],
        #type-photo:checked ~ .filters label[for="type-photo"],
        #type-media:checked ~ .filters label[for="type-media"],
        #type-history:checked ~ .filters label[for="type-history"],
        #area-all:checked ~ .filters label[for="area-all"],
        #area-jongno:checked ~ .filters label[for="area-jongno"],
        #area-jung:checked ~ .filters label[for="area-jung"],
        #area-nowon:checked ~ .filters label[for="area-nowon"],
        #area-seongbuk:checked ~ .filters label[for="area-seongbuk"] {
            background: var(--ss-yellow);
            color: var(--ss-ink);
            border-color: var(--ss-yellow);
            box-shadow: none;
        }

        /* [섹션 제목 색] 지도 설명, 전시 섹션, 지역 제목을 진한 글자색으로 맞춥니다. */
        .map-topline strong,
        .section-heading h2,
        .district-title h2 {
            color: var(--ss-ink);
        }

        .map-stage {
            background: #ECEFF6;
            border: 1px solid var(--ss-line);
            border-radius: 22px;
            box-shadow: 0 14px 40px rgba(21, 27, 39, .07);
            overflow: hidden;
        }

        .seoul-map {
            filter: drop-shadow(0 10px 12px rgba(21, 27, 39, .10));
        }

        .district {
            fill: #D8E0F3;
            stroke: var(--ss-white);
            stroke-width: 2.2;
            transition: fill .22s ease, filter .22s ease;
        }

        .district-link:hover .district,
        .district-link:focus .district {
            fill: var(--ss-yellow);
            filter: drop-shadow(0 3px 3px rgba(21, 27, 39, .10));
        }

        .district-label {
            fill: var(--ss-ink);
            stroke: #D8E0F3;
        }

        .district-link:hover .district-label {
            stroke: var(--ss-yellow);
        }

        .river {
            stroke: #8EA8DF;
        }

        .river-edge {
            stroke: rgba(255, 255, 255, .9);
        }

        .map-legend {
            background: rgba(255, 255, 255, .94);
            border: 1px solid var(--ss-line);
            border-radius: 12px;
            color: var(--ss-ink);
        }

        .legend-dot {
            border-color: rgba(21, 27, 39, .15);
        }

        /* [범례 색상] 범례 항목별 노랑·주황·파랑·초록 색을 지정합니다. */
        .yellow { background: var(--ss-yellow); }
        .orange { background: #E9A28A; }
        .blue { background: #8EA8DF; }
        .green { background: #A9C9B2; }

        .map-hint {
            background: var(--ss-yellow);
            border: 1px solid rgba(21, 27, 39, .12);
            border-radius: 10px;
            color: var(--ss-ink);
        }

        /* [지역 상세·전시 영역] 관련 콘텐츠 영역의 경계선 색을 통일합니다. */
        .district-content,
        .district-placeholder,
        .exhibition-section {
            border-color: var(--ss-line);
        }

        .district-tag {
            background: var(--ss-yellow);
            border: 0;
            border-radius: 6px;
            color: var(--ss-ink);
        }

        /* [대표 전시 카드] 대표 콘텐츠 카드의 배경, 둥근 모서리와 그림자입니다. */
        .featured {
            border: 1px solid var(--ss-line);
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 14px 40px rgba(21, 27, 39, .08);
            background: var(--ss-yellow);
        }

        /* [대표 카드 이미지 영역] 실제 이미지 대신 쓰는 그래픽 영역의 배경색입니다. */
        .featured-art {
            background: #E4E9F5;
        }

        /* [대표 그래픽 장식] 원·도형·선 장식의 색상을 브랜드 팔레트로 맞춥니다. */
        .art-circle {
            background: var(--ss-yellow);
            border-color: rgba(21, 27, 39, .18);
        }

        .art-shape {
            background: var(--ss-blue);
            border-color: rgba(21, 27, 39, .14);
        }

        .art-line {
            background: var(--ss-ink);
        }

        /* [그래픽 라벨·포스터 태그] 작은 라벨을 흰 배경과 테두리로 표시합니다. */
        .art-label,
        .poster-tag {
            background: var(--ss-white);
            border: 1px solid var(--ss-line);
            border-radius: 6px;
            color: var(--ss-ink);
        }

        /* [대표 카드 버튼] 대표 전시 링크를 파란색 버튼처럼 보이게 합니다. */
        .featured-link {
            background: var(--ss-blue);
            color: var(--ss-white);
            border-radius: 10px;
        }

        /* [대표 버튼 호버] 마우스를 올리면 버튼 파란색을 조금 더 진하게 바꿉니다. */
        .featured-link:hover {
            background: var(--ss-blue-hover);
            color: var(--ss-white);
        }

        /* [필터 묶음] 필터 영역의 구분선 색을 공통 테마에 맞춥니다. */
        .filters {
            border-color: var(--ss-line);
        }

        /* [필터 설명] 필터 종류를 안내하는 보조 글자를 회색으로 표시합니다. */
        .filter-label {
            color: var(--ss-muted);
        }

        /* [필터 호버] 필터 옵션에 마우스를 올리면 연한 파란색 배경을 표시합니다. */
        .filter-option:hover {
            background: #E8ECF6;
        }

        /* [전시 카드] 전시·행사 카드의 흰 배경, 테두리, 둥근 모서리와 그림자입니다. */
        .exhibition-card,
        .event-card {
            background: var(--ss-white);
            border: 1px solid var(--ss-line);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(21, 27, 39, .025);
        }

        /* [카드 호버] 카드에 마우스를 올리면 살짝 올라오며 그림자가 진해집니다. */
        .exhibition-card:hover,
        .event-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(21, 27, 39, .09);
        }

        /* [포스터 영역] 포스터 아래쪽에 콘텐츠와 구분되는 선을 넣습니다. */
        .poster,
        .event-poster {
            border-bottom: 1px solid var(--ss-line);
        }

        /* [포스터 색상 변형] 특정 포스터 유형의 배경색과 장식 테두리를 지정합니다. */
        .poster-two,
        .poster-music {
            background: var(--ss-blue);
        }

        .poster-two::before,
        .poster-music::before {
            border-color: var(--ss-yellow);
        }

        /* [노란 포스터] 네 번째 포스터 유형의 배경을 브랜드 노란색으로 설정합니다. */
        .poster-four {
            background: var(--ss-yellow);
        }

        /* [카드 제목] 전시·행사 카드 제목을 진한 색으로 표시합니다. */
        .card-info h3,
        .event-info h3 {
            color: var(--ss-ink);
        }

        /* [카드 설명] 전시·행사 카드의 설명문은 회색으로 표시합니다. */
        .card-info p,
        .event-info p {
            color: var(--ss-muted);
        }

        /* [카드 링크] 카드 하단 링크의 테두리와 글자색을 파란색 계열로 맞춥니다. */
        .card-link,
        .event-link {
            border-color: var(--ss-line);
            color: var(--ss-blue);
        }

        /* [샘플·빈 결과 안내] 샘플 데이터나 결과 없음 안내를 흰 배경 상자로 표시합니다. */
        .sample-note,
        .empty-message {
            background: var(--ss-white);
            border-color: var(--ss-blue);
            border-radius: 10px;
            color: var(--ss-muted);
        }

        .placeholder-inner {
            background: #E9EDF7;
            border: 1px solid var(--ss-line);
            border-radius: 18px;
        }

        .placeholder-inner a {
            background: var(--ss-blue);
            color: var(--ss-white);
            border: 0;
            border-radius: 10px;
        }

        footer {
            background: var(--ss-ink);
            color: rgba(255, 255, 255, .78);
        }

        footer strong {
            color: var(--ss-yellow);
        }

        footer strong span {
            background: var(--ss-yellow);
            color: var(--ss-ink);
        }

        @media (max-width: 900px) {
            header {
                padding: 12px 5%;
            }
        }

        @media (max-width: 560px) {
            body {
                padding-top: 112px;
            }

            header {
                min-height: 76px;
                padding: 12px 5%;
                row-gap: 8px;
            }

            .logo {
                font-size: 21px;
            }
        }

        /* [움직임 최소화 설정] 기기에서 애니메이션 줄이기를 요청한 경우 전환 효과를 최소화합니다. */
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                scroll-behavior: auto !important;
                transition-duration: .01ms !important;
                animation-duration: .01ms !important;
            }
        }

    
        /* [요청한 상단 바] 참고 이미지처럼 로고-중앙 메뉴-우측 도구를 한 줄로 정렬합니다. */
        .site-header {
            position: fixed !important;
            inset: 0 0 auto 0 !important;
            z-index: 2000 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            width: 100%;
            min-height: 76px !important;
            padding: 0 3% !important;
            gap: 28px !important;
            background: #F6F5F1 !important;
            border: 0 !important;
            box-shadow: none !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
        }
        /* [로고] 콜론만 브랜드 파란색으로 표시합니다. */
        .site-header .logo {
            flex: 0 0 auto;
            color: #151B27 !important;
            font-size: 29px !important;
            line-height: 1;
            font-weight: 900 !important;
            letter-spacing: -1.8px !important;
            white-space: nowrap;
        }
        .site-header .logo span {
            padding: 0 !important;
            background: transparent !important;
            color: #4666B0 !important;
            border-radius: 0 !important;
        }
        /* [중앙 메뉴] 메뉴를 가운데 두고, 현재 페이지는 아래쪽 검은 선으로 표시합니다. */
        .site-header .main-nav {
            display: flex !important;
            flex: 1 1 auto;
            align-items: center !important;
            justify-content: center !important;
            gap: clamp(17px, 1.7vw, 34px) !important;
            margin: 0 !important;
            color: #151B27 !important;
            font-size: 16px !important;
            font-weight: 800 !important;
            letter-spacing: -.4px !important;
            white-space: nowrap;
        }
        .site-header .main-nav a {
            display: inline-flex;
            align-items: center;
            min-height: 43px;
            padding: 3px 0 0 !important;
            border: 0 !important;
            border-bottom: 3px solid transparent !important;
            color: #151B27 !important;
            background: transparent !important;
        }
        .site-header .main-nav a.active,
        .site-header .main-nav a:hover {
            color: #151B27 !important;
            border-bottom-color: #151B27 !important;
        }
        /* [우측 도구] 검색, 언어, 로그인, 마이페이지, 날씨를 한 줄로 배치합니다. */
        .site-header .header-tools {
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: flex-end;
            gap: clamp(12px, 1.15vw, 22px);
            color: #151B27;
            font-size: 14px;
            font-weight: 800;
            white-space: nowrap;
        }
        .site-header .header-tools a { color: #151B27 !important; text-decoration: none; }
        .site-header .header-tools a:hover { color: #4666B0 !important; }
        .icon-link { display: inline-flex; align-items: center; justify-content: center; font-size: 24px; line-height: 1; }
        .search-icon { display: inline-block; width: 16px; height: 16px; border: 2px solid currentColor; border-radius: 50%; position: relative; }
        .search-icon::after { content: ""; position: absolute; width: 7px; height: 2px; right: -5px; bottom: -3px; background: currentColor; transform: rotate(48deg); border-radius: 2px; }
        .language-link { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; }
        .globe-icon { display: inline-flex; align-items: center; justify-content: center; width: 21px; height: 21px; border: 2px solid currentColor; border-radius: 50%; font-size: 19px; line-height: 16px; }
        .weather-icon { font-size: 25px; }
        /* [작은 화면] 헤더 공간이 부족하면 글자와 간격을 줄입니다. */
        @media (max-width: 1000px) {
            .site-header { padding: 0 20px !important; gap: 16px !important; }
            .site-header .logo { font-size: 23px !important; }
            .site-header .main-nav { gap: 13px !important; font-size: 13px !important; }
            .site-header .header-tools { gap: 10px; font-size: 12px; }
        }
        @media (max-width: 760px) {
            .site-header { min-height: auto !important; padding: 14px 18px !important; flex-wrap: wrap; }
            body { padding-top: 112px !important; }
            .site-header .logo { font-size: 22px !important; }
            .site-header .main-nav { order: 3; flex: 1 0 100%; justify-content: flex-start !important; overflow-x: auto; gap: 20px !important; }
            .site-header .header-tools { margin-left: auto; }
            .site-header .weather-icon, .site-header .language-link { display: none; }
        }

    

        /* ===== SCENE:SEOUL refinement patch ===== */
        :root {
            --ss-blue: #4666B0;
            --ss-blue-hover: #344F94;
            --ss-yellow: #FFDB63;
            --ss-paper: #F6F4EF;
            --ss-ink: #151B27;
            --ss-muted: #747B85;
            --ss-line: #DFE1DF;
            --ss-white: #FFFFFF;
        }
        html { scroll-behavior: smooth; }
        body {
            background: var(--ss-paper) !important;
            color: var(--ss-ink) !important;
            font-family: "DM Sans", "Noto Sans KR", sans-serif !important;
            overflow-x: clip;
            -webkit-font-smoothing: antialiased;
            text-rendering: optimizeLegibility;
        }
        h1, h2, h3, h4, p { overflow-wrap: break-word; }
        p { word-break: keep-all; }
        a { -webkit-tap-highlight-color: transparent; }
        .site-header {
            position: sticky !important;
            top: 0;
            z-index: 100;
            min-height: 78px;
            padding: 12px clamp(20px, 4vw, 64px) !important;
            gap: clamp(12px, 1.5vw, 26px) !important;
            background: rgba(246, 244, 239, .96) !important;
            border-bottom: 1px solid var(--ss-line) !important;
            backdrop-filter: blur(16px);
        }
        .site-header .logo {
            flex: 0 0 auto;
            font-size: clamp(20px, 1.8vw, 27px) !important;
            line-height: 1.1;
            letter-spacing: -1.2px !important;
            color: var(--ss-ink) !important;
        }
        .site-header .logo span {
            display: inline-block;
            padding: 2px 4px !important;
            background: var(--ss-yellow) !important;
        }
        .site-header .main-nav {
            min-width: 0;
            gap: clamp(10px, 1.25vw, 22px) !important;
            font-size: clamp(11px, .9vw, 14px) !important;
        }
        .site-header .main-nav a {
            flex-shrink: 0;
            min-height: 38px !important;
            line-height: 1.3;
            white-space: nowrap;
        }
        .site-header .header-tools {
            gap: clamp(9px, 1vw, 16px) !important;
            font-size: 12px !important;
        }
        .site-header .header-tools a { white-space: nowrap; }
        .language-link { gap: 5px; }
        .globe-icon {
            position: relative;
            flex: 0 0 19px;
            width: 19px !important;
            height: 19px !important;
            border: 1.6px solid currentColor !important;
            border-radius: 50%;
            font-size: 0 !important;
            line-height: 0 !important;
        }
        .globe-icon::before {
            content: "";
            position: absolute;
            inset: 1px 4px;
            border: 1px solid currentColor;
            border-radius: 50%;
        }
        .globe-icon::after {
            content: "";
            position: absolute;
            left: 1px;
            right: 1px;
            top: 7px;
            height: 3px;
            border-top: 1px solid currentColor;
            border-bottom: 1px solid currentColor;
        }
        .site-header .header-tools .icon-link { min-width: 22px; min-height: 28px; }
        .site-header a:focus-visible,
        .district-link:focus-visible,
        .card-link:focus-visible,
        .event-link:focus-visible {
            outline: 3px solid var(--ss-blue) !important;
            outline-offset: 4px;
            border-radius: 4px;
        }
        .intro, .page-intro { padding-top: clamp(34px, 5vw, 66px) !important; }
        .intro h1, .page-intro h1 {
            line-height: .98 !important;
            letter-spacing: -.065em !important;
            overflow-wrap: normal;
        }
        .intro-bottom {
            align-items: flex-end;
            flex-wrap: wrap;
        }
        .intro-bottom p, .page-intro p {
            max-width: 620px;
            line-height: 1.8 !important;
            font-size: clamp(13px, 1vw, 15px) !important;
        }
        .intro-side, .edition { line-height: 1.7 !important; }
        .map-stage {
            min-height: 480px !important;
            padding: clamp(26px, 4vw, 48px) clamp(16px, 5vw, 60px) !important;
            border: 1px solid var(--ss-line) !important;
            border-radius: 24px !important;
            background: #E8EBF2 !important;
            box-shadow: 0 16px 38px rgba(21, 27, 39, .09) !important;
            overflow: hidden;
        }
        .seoul-map { max-width: 720px; max-height: 72vh; }
        .district { stroke-width: 2.4; stroke-linejoin: round; stroke-linecap: round; }
        .district-label {
            font-family: "Noto Sans KR", sans-serif !important;
            font-size: 10.5px !important;
            font-weight: 800 !important;
            paint-order: stroke fill;
            stroke-width: 3px !important;
        }
        .map-legend, .map-hint {
            border: 1px solid rgba(21, 27, 39, .12) !important;
            border-radius: 12px !important;
            box-shadow: 0 5px 16px rgba(21, 27, 39, .08);
            font-size: 11px !important;
            line-height: 1.9 !important;
        }
        .map-hint { background: var(--ss-yellow) !important; }
        .category-filters a, .local-filters a {
            transition: transform .22s ease, background .22s ease, box-shadow .22s ease;
        }
        .category-filters a:hover, .local-filters a:hover { transform: translateY(-2px); }

        /* District detail becomes a right-side drawer instead of a page-bottom section. */
        .district-content { display: none !important; }
        .district-content:target {
            display: block !important;
            position: fixed !important;
            z-index: 250 !important;
            top: 94px !important;
            right: clamp(14px, 2vw, 30px) !important;
            bottom: 18px !important;
            width: min(430px, calc(100vw - 28px)) !important;
            max-height: calc(100dvh - 112px) !important;
            margin: 0 !important;
            padding: 27px 24px 30px !important;
            overflow: auto !important;
            overscroll-behavior: contain;
            background: var(--ss-paper) !important;
            border: 1px solid rgba(21, 27, 39, .12) !important;
            border-radius: 22px !important;
            box-shadow: 0 24px 70px rgba(21, 27, 39, .22) !important;
            scroll-margin: 0 !important;
            animation: drawer-in .32s cubic-bezier(.16, 1, .3, 1) both;
        }
        @keyframes drawer-in {
            from { opacity: 0; transform: translateX(28px) translateY(8px); }
            to { opacity: 1; transform: translateX(0) translateY(0); }
        }
        .district-content:target::before {
            content: "SELECTED DISTRICT";
            display: block;
            margin: 0 0 16px;
            color: var(--ss-blue);
            font-size: 10px;
            font-weight: 900;
            letter-spacing: .16em;
        }
        .district-title { align-items: flex-start !important; gap: 12px !important; }
        .district-title h2, .district-content > h2 {
            margin: 0 !important;
            color: var(--ss-ink);
            font-size: clamp(27px, 3vw, 36px) !important;
            line-height: 1.2 !important;
            letter-spacing: -.055em !important;
            word-break: keep-all;
        }
        .district-title p, .district-content > p {
            margin-top: 10px !important;
            color: var(--ss-muted);
            font-size: 13px !important;
            line-height: 1.75 !important;
            word-break: keep-all;
        }
        .district-title > strong { font-size: 10px !important; white-space: nowrap; }
        .district-tag { border: 0 !important; border-radius: 6px; background: var(--ss-yellow) !important; }
        .local-filters { gap: 7px !important; margin: 20px 0 !important; }
        .local-filters a {
            padding: 8px 12px !important;
            border-color: var(--ss-line) !important;
            background: #fff !important;
            font-size: 11px !important;
        }
        .local-filters a.selected, .local-filters a:hover {
            border-color: var(--ss-blue) !important;
            background: var(--ss-blue) !important;
            color: #fff !important;
        }
        .local-grid { display: grid !important; grid-template-columns: 1fr !important; gap: 14px !important; }
        .event-card {
            display: grid !important;
            grid-template-columns: 105px minmax(0, 1fr) !important;
            min-width: 0;
            overflow: hidden;
            border: 1px solid var(--ss-line) !important;
            border-radius: 14px !important;
            background: #fff !important;
            box-shadow: none !important;
        }
        .event-poster { height: auto !important; min-height: 130px; border: 0 !important; }
        .event-info { min-width: 0; padding: 13px !important; }
        .event-info h3 { margin: 0 0 8px !important; font-size: 14px !important; line-height: 1.4 !important; word-break: keep-all; }
        .event-info p { margin: 5px 0 !important; font-size: 11px !important; line-height: 1.55 !important; word-break: keep-all; }
        .event-link { display: inline-flex; gap: 5px; margin-top: 7px; font-size: 11px !important; font-weight: 800; }
        .sample-note { font-size: 11px !important; line-height: 1.65 !important; color: var(--ss-muted); }
        .empty-message { padding: 16px !important; border-radius: 12px; background: #fff; color: var(--ss-muted); font-size: 12px !important; line-height: 1.7 !important; }
        .map-section { scroll-margin-top: 100px; }

        /* Exhibition page: protect title/card typography from collision and restore designed poster artwork. */
        .featured { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(22px, 4vw, 56px); align-items: stretch; }
        .featured-info { min-width: 0; align-self: center; }
        .featured-info h2, .featured-info h3 { line-height: 1.1 !important; letter-spacing: -.055em !important; overflow-wrap: break-word; }
        .exhibition-grid { align-items: stretch; gap: clamp(16px, 2vw, 26px) !important; }
        .exhibition-card { min-width: 0; overflow: hidden; border-radius: 16px !important; }
        .poster { height: clamp(190px, 22vw, 280px) !important; }
        .card-info { min-width: 0; padding: 18px !important; }
        .card-info h3 { margin: 10px 0 !important; font-size: clamp(17px, 1.5vw, 22px) !important; line-height: 1.35 !important; letter-spacing: -.04em !important; word-break: keep-all; }
        .card-info p { font-size: 12px !important; line-height: 1.75 !important; word-break: keep-all; }
        .card-meta { display: flex; flex-wrap: wrap; gap: 7px 12px; font-size: 10px !important; line-height: 1.6; }
        .card-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 12px; font-size: 11px !important; font-weight: 900; }
        .filters { flex-wrap: wrap; gap: 9px !important; }
        .filter-row { flex-wrap: wrap; gap: 8px !important; }
        .filter-option { line-height: 1.35; }
        footer { display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; padding: 26px 5% !important; line-height: 1.6; }

        @media (max-width: 1120px) {
            .site-header { flex-wrap: wrap; }
            .site-header .main-nav { order: 3; flex: 1 0 100%; justify-content: flex-start !important; overflow-x: auto; padding-bottom: 3px; }
            .site-header .header-tools { margin-left: auto; }
        }
        @media (max-width: 760px) {
            .site-header { position: sticky !important; padding: 12px 18px !important; }
            .site-header .main-nav { order: 3; flex: 1 0 100%; }
            .site-header .header-tools { gap: 10px !important; }
            .site-header .weather-icon { display: none; }
            .intro h1, .page-intro h1 { font-size: clamp(48px, 13vw, 76px) !important; letter-spacing: -.07em !important; }
            .intro-bottom { align-items: flex-start; }
            .intro-side, .edition { text-align: left !important; }
            .map-stage { min-height: 360px !important; padding: 54px 8px 48px !important; border-radius: 18px !important; }
            .seoul-map { width: 100%; }
            .map-legend { left: 10px; top: 10px; padding: 7px 9px; }
            .map-hint { right: 10px; bottom: 10px; max-width: 65%; }
            .district-content:target { top: 118px !important; right: 10px !important; bottom: 10px !important; width: calc(100vw - 20px) !important; max-height: calc(100dvh - 128px) !important; padding: 22px 17px !important; }
            .featured { grid-template-columns: 1fr; }
            .exhibition-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
            .poster { height: 190px !important; }
            .card-info { padding: 13px !important; }
            .event-card { grid-template-columns: 88px minmax(0,1fr) !important; }
        }
        @media (max-width: 440px) {
            .site-header .logo { font-size: 20px !important; }
            .site-header .header-tools .language-link { display: none; }
            .site-header .header-tools .account-link { font-size: 10px; }
            .exhibition-grid { grid-template-columns: 1fr !important; }
            .poster { height: 240px !important; }
            .map-topline { align-items: flex-start; flex-direction: column; }
        }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; }
        }



        /* ======================================================
           FINAL OVERRIDES — SCENE:SEOUL MAP
           common.css / category.css의 색상과 타이포그래피 기준
           로고 콜론 박스 제거 + 지도 중심 레이아웃
        ====================================================== */
        :root {
            --ss-blue: #4666B0;
            --ss-blue-hover: #344F94;
            --ss-yellow: #FFDB63;
            --ss-paper: #F6F4EF;
            --ss-ink: #151B27;
            --ss-muted: #747B85;
            --ss-line: #DFE1DF;
            --ss-white: #FFFFFF;
            --ss-ease: cubic-bezier(.16,1,.3,1);
        }
        body { background: var(--ss-paper) !important; color: var(--ss-ink) !important; }
        .site-header {
            display:flex; align-items:center; justify-content:space-between;
            gap:clamp(12px,2vw,28px); padding:14px clamp(18px,4vw,64px) !important;
            min-height:76px; background:rgba(246,244,239,.96) !important;
            border-bottom:1px solid var(--ss-line) !important;
            box-shadow:0 5px 24px rgba(21,27,39,.035);
        }
        .site-header .logo {
            display:inline-flex; align-items:center; gap:0; flex:none;
            padding:0 !important; margin:0; background:transparent !important;
            color:var(--ss-ink) !important; font-family:'DM Sans','Noto Sans KR',sans-serif !important;
            font-size:clamp(20px,2vw,27px) !important; font-weight:900 !important;
            letter-spacing:-1.4px !important; line-height:1 !important;
            border:0 !important; box-shadow:none !important; white-space:nowrap;
        }
        .site-header .logo .logo-word { display:inline; padding:0 !important; margin:0; background:transparent !important; color:var(--ss-ink) !important; border:0 !important; border-radius:0 !important; }
        .site-header .logo .logo-colon { display:inline !important; padding:0 !important; margin:0 1px !important; background:transparent !important; color:var(--ss-blue) !important; border:0 !important; border-radius:0 !important; box-shadow:none !important; font:inherit !important; line-height:inherit !important; }
        .site-header .main-nav { gap:clamp(10px,1.6vw,24px) !important; font-size:11px !important; color:var(--ss-muted) !important; }
        .site-header .main-nav a { padding:8px 0 !important; color:var(--ss-muted) !important; background:transparent !important; border-bottom:2px solid transparent !important; transition:color .22s ease,border-color .22s ease; white-space:nowrap; }
        .site-header .main-nav a:hover,.site-header .main-nav a.active { color:var(--ss-blue) !important; border-bottom-color:var(--ss-blue) !important; }
        .site-header .header-tools { display:flex; align-items:center; gap:clamp(9px,1.3vw,18px) !important; color:var(--ss-ink); }
        .site-header .header-tools a { color:var(--ss-ink) !important; font-size:10px !important; font-weight:800; white-space:nowrap; }
        .site-header .header-tools a:hover { color:var(--ss-blue) !important; background:transparent !important; }
        .site-header .icon-link,.site-header .language-link { border:0 !important; box-shadow:none !important; background:transparent !important; }
        .intro { padding:clamp(32px,5vw,62px) clamp(22px,5vw,76px) 22px !important; }
        .eyebrow { color:var(--ss-blue) !important; letter-spacing:.16em !important; }
        .eyebrow::before { background:var(--ss-yellow) !important; border:0 !important; }
        .intro h1 { color:var(--ss-ink) !important; font-size:clamp(48px,7vw,84px) !important; letter-spacing:-.075em !important; line-height:.98 !important; }
        .intro h1 span { color:var(--ss-blue) !important; -webkit-text-stroke:0 !important; }
        .intro-bottom p,.intro-side { color:var(--ss-muted) !important; }
        .category-filters { padding:16px clamp(22px,5vw,76px) 24px !important; gap:9px !important; }
        .category-filters a { min-width:0 !important; padding:10px 16px !important; border:1px solid var(--ss-line) !important; border-radius:999px !important; color:var(--ss-ink) !important; background:transparent !important; box-shadow:none !important; font-size:11px !important; transition:transform .25s var(--ss-ease),background .25s,border-color .25s,color .25s,box-shadow .25s !important; }
        .category-filters a:hover { transform:translateY(-2px); border-color:var(--ss-blue) !important; color:var(--ss-blue) !important; box-shadow:0 8px 18px rgba(21,36,83,.09) !important; }
        .category-filters a.selected { background:var(--ss-ink) !important; border-color:var(--ss-ink) !important; color:#fff !important; box-shadow:none !important; }
        .map-section { padding:0 clamp(18px,4vw,64px) 70px !important; scroll-margin-top:90px; }
        .map-topline { margin-bottom:14px !important; }
        .map-topline strong { color:var(--ss-ink) !important; font-size:11px !important; letter-spacing:.12em !important; }
        .map-topline span { color:var(--ss-muted) !important; font-size:10px !important; letter-spacing:.06em; }
        .map-stage {
            min-height:min(72vh,760px) !important; padding:clamp(20px,4vw,54px) !important;
            border:1px solid var(--ss-line) !important; border-radius:24px !important;
            background:transparent !important; box-shadow:none !important; overflow:hidden;
            isolation:isolate;
        }
        .seoul-map { width:min(100%,760px) !important; max-width:760px !important; max-height:76vh !important; filter:drop-shadow(0 14px 18px rgba(21,27,39,.08)) !important; transform-origin:center; transition:transform .6s var(--ss-ease),filter .4s ease; }
        .district { fill:#FFFFFF !important; stroke:#C9CDD2 !important; stroke-width:1.7 !important; stroke-linejoin:round !important; stroke-linecap:round !important; transition:fill .24s ease,stroke .24s ease,filter .24s ease,transform .55s var(--ss-ease) !important; }
        .district-link:hover .district,.district-link:focus-visible .district { fill:#DCE5FA !important; stroke:var(--ss-blue) !important; stroke-width:2.5 !important; filter:drop-shadow(0 4px 5px rgba(70,102,176,.22)); }
        .district-label { fill:var(--ss-ink) !important; stroke:#FFFFFF !important; stroke-width:2.8px !important; font-family:'DM Sans','Noto Sans KR',sans-serif !important; font-size:10px !important; font-weight:800 !important; }
        .district-link:hover .district-label { fill:var(--ss-blue) !important; stroke:#DCE5FA !important; }
        .river { stroke:#E9BFC9 !important; stroke-width:22 !important; stroke-linecap:round !important; stroke-linejoin:round !important; }
        .river-edge { stroke:rgba(255,255,255,.75) !important; }
        .map-legend { left:16px !important; top:16px !important; border:1px solid var(--ss-line) !important; border-radius:12px !important; background:rgba(255,255,255,.94) !important; color:var(--ss-ink) !important; box-shadow:0 8px 22px rgba(21,27,39,.07) !important; }
        .map-hint { right:16px !important; bottom:16px !important; border:0 !important; border-radius:999px !important; background:var(--ss-yellow) !important; color:var(--ss-ink) !important; box-shadow:0 8px 20px rgba(21,27,39,.08) !important; }
        .district-content:target { animation:drawer-in .55s var(--ss-ease) both !important; border:1px solid var(--ss-line) !important; border-radius:22px !important; background:var(--ss-paper) !important; box-shadow:0 24px 70px rgba(21,27,39,.18) !important; }
        .district-content:target::before { color:var(--ss-blue) !important; }
        .district-tag { background:var(--ss-yellow) !important; color:var(--ss-ink) !important; border:0 !important; border-radius:6px !important; }
        .local-filters a { border:1px solid var(--ss-line) !important; border-radius:999px !important; box-shadow:none !important; }
        .local-filters a.selected,.local-filters a:hover { background:var(--ss-blue) !important; border-color:var(--ss-blue) !important; color:#fff !important; }
        .event-card { border:1px solid var(--ss-line) !important; border-radius:15px !important; background:#fff !important; box-shadow:0 2px 7px rgba(21,27,39,.025) !important; transition:transform .3s var(--ss-ease),box-shadow .3s var(--ss-ease),border-color .3s ease !important; }
        .event-card:hover { transform:translateY(-4px) !important; border-color:#C6D0E8 !important; box-shadow:0 16px 30px rgba(21,36,83,.13) !important; }
        .event-poster { background:#E8EAF0 !important; }
        .event-info h3 { color:var(--ss-ink) !important; }
        .event-info p,.sample-note,.empty-message { color:var(--ss-muted) !important; }
        footer { background:transparent !important; border-top:1px solid var(--ss-line) !important; color:var(--ss-muted) !important; }
        footer strong { color:var(--ss-ink) !important; }
        footer strong span { color:var(--ss-blue) !important; background:transparent !important; }
        a:focus-visible { outline:2px solid var(--ss-blue); outline-offset:4px; }
        @media (max-width:760px) {
            .site-header { gap:10px !important; }
            .site-header .main-nav { order:3; flex:1 0 100%; }
            .intro { padding-top:32px !important; }
            .intro-bottom { gap:12px; }
            .intro-side { font-size:9px !important; }
            .map-stage { min-height:360px !important; padding:52px 6px 48px !important; }
            .seoul-map { max-height:none !important; }
            .map-legend { font-size:9px !important; }
        }
        @media (prefers-reduced-motion:reduce) {
            *,*::before,*::after { scroll-behavior:auto !important; animation-duration:.01ms !important; animation-iteration-count:1 !important; transition-duration:.01ms !important; }
        }

    </style>
</head>

<body>

<header class="site-header">
    <a href="#map" class="logo" aria-label="SCENE:SEOUL 홈"><span class="logo-word">SCENE</span><span class="logo-colon">:</span><span class="logo-word">SEOUL</span></a>
    <nav class="main-nav" aria-label="주요 메뉴">
        <a href="#home" class="">HOME</a>
        <a href="#exhibition" class="">전시</a>
        <a href="#performance" class="">공연</a>
        <a href="#popup" class="">팝업</a>
        <a href="#event" class="">이벤트</a>
        <a href="#recommend" class="">추천</a>
        <a href="#map" class="active">지도</a>
    </nav>
    <div class="header-tools">
        <a class="icon-link" href="#search" aria-label="검색"><span class="search-icon"></span></a>
        <a class="language-link" href="#language" aria-label="언어 선택 (한국어)" title="언어 선택"><span class="globe-icon" aria-hidden="true"></span><span>KR</span></a>
        <a class="account-link" href="#login">LOGIN</a>
        <a class="account-link" href="#mypage">MY PAGE</a>
        <a class="icon-link weather-icon" href="#weather" aria-label="날씨">☁</a>
    </div>
</header>

<main>

    <section class="intro">
        <div class="eyebrow">EXPLORE SEOUL</div>

        <h1>SEOUL <span>MAP.</span></h1>

        <div class="intro-bottom">
            <p>
                서울 곳곳의 전시, 공연, 팝업, 이벤트를<br>
                지도에서 한눈에 만나보세요.
            </p>

            <div class="intro-side">
                ART, MUSIC, POP-UP, EVENT.<br>
                ALL IN SEOUL.<br>
                FIND YOUR SCENE.
            </div>
        </div>
    </section>

    <div class="category-filters">
        <a href="#map" class="selected">⌖ALL</a>
        <a href="#exhibition-list">전시</a>
        <a href="#performance-list">공연</a>
        <a href="#popup-list">팝업</a>
        <a href="#event-list">이벤트</a>
    </div>

    <section class="map-section" id="map">

        <div class="map-topline">
            <strong>SEOUL / DISTRICT MAP</strong>
            <span>SELECT A DISTRICT TO EXPLORE ↘</span>
        </div>

        <div class="map-stage">

            <div class="map-legend">
                <div><span class="legend-dot yellow"></span>전시</div>
                <div><span class="legend-dot orange"></span>공연</div>
                <div><span class="legend-dot blue"></span>팝업</div>
                <div><span class="legend-dot green"></span>이벤트</div>
            </div>

            <!--
                지도는 디자인용 SVG 시안입니다.
                실제 행정구역 경계와 완전히 일치하는 지도는 아닙니다.
                각 구역은 클릭할 수 있습니다.
            -->

            <svg class="seoul-map"
                viewBox="0 0 620 590"
                xmlns="http://www.w3.org/2000/svg"
                role="img"
                aria-label="서울 자치구 선택 지도">

                <!-- 한강을 구역보다 먼저 그려 경계 안쪽에 배치 -->

                <!-- 한강은 자치구 면 위에 그려 지도에서 선명하게 보이도록 합니다. -->
                <g class="districts">

                    <a class="district-link" href="#dobong" aria-label="도봉구">
                        <path class="district" d="M278 15 L322 9 L351 32 L344 71 L319 94 L284 84 L266 48 Z"/>
                        <text class="district-label" x="307" y="49">도봉구</text>
                    </a>

                    <a class="district-link" href="#nowon" aria-label="노원구">
                        <path class="district" d="M322 9 L365 20 L397 46 L405 91 L429 118 L411 151 L374 159 L344 137 L319 94 L344 71 L351 32 Z"/>
                        <text class="district-label" x="379" y="91">노원구</text>
                    </a>

                    <a class="district-link" href="#gangbuk" aria-label="강북구">
                        <path class="district" d="M266 48 L284 84 L319 94 L344 137 L322 165 L289 158 L264 128 L248 91 Z"/>
                        <text class="district-label" x="298" y="126">강북구</text>
                    </a>

                    <a class="district-link" href="#eunpyeong" aria-label="은평구">
                        <path class="district" d="M185 119 L225 96 L248 91 L264 128 L289 158 L270 190 L242 208 L207 191 L184 160 Z"/>
                        <text class="district-label" x="230" y="157">은평구</text>
                    </a>

                    <a class="district-link" href="#seongbuk" aria-label="성북구">
                        <path class="district" d="M289 158 L322 165 L344 137 L374 159 L369 192 L344 217 L307 207 L270 190 Z"/>
                        <text class="district-label" x="326" y="184">성북구</text>
                    </a>

                    <a class="district-link" href="#jungnang" aria-label="중랑구">
                        <path class="district" d="M374 159 L411 151 L429 178 L442 210 L420 239 L391 231 L369 192 Z"/>
                        <text class="district-label" x="408" y="202">중랑구</text>
                    </a>

                    <a class="district-link" href="#dongdaemun" aria-label="동대문구">
                        <path class="district" d="M344 217 L369 192 L391 231 L379 257 L349 268 L330 244 Z"/>
                        <text class="district-label" x="359" y="236">동대문구</text>
                    </a>

                    <a class="district-link" href="#jongno" aria-label="종로구">
                        <path class="district" d="M270 190 L307 207 L330 244 L303 266 L276 257 L253 231 L242 208 Z"/>
                        <text class="district-label" x="284" y="229">종로구</text>
                    </a>

